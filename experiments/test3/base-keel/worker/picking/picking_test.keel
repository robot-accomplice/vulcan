package picking

import (
    "errors"
    "strings"
    "testing"

    "keel.dev/keel"
    "shop/lib/shop"
)

// The note limit bounds the message; an oversized note must not be published.
func TestShipEnforcesNoteLimit(t *testing.T) {
    if err := ship("o-1", strings.Repeat("x", shop.MaxNoteBytes)); err != nil {
        t.Fatalf("note at the limit: %v", err)
    }
    if err := ship("o-2", strings.Repeat("x", shop.MaxNoteBytes+1)); !errors.Is(err, ErrNoteTooBig) {
        t.Fatalf("note over the limit: got %v", err)
    }
    got := keel.Published(t, Shipped)
    if len(got) != 1 || got[0].Order != "o-1" {
        t.Fatalf("published %+v", got)
    }
}
