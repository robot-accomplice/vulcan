package orders

import (
    "errors"
    "testing"

    "keel.dev/keel"
    "shop/lib/shop"
)

// paymentsFake records refunds so a test can see that Cancel asked for one.
// It meets the Payments contract: each receipt echoes the order and the amount.
type paymentsFake struct {
    refunds   []shop.Money
    refundErr error
}

func (f *paymentsFake) Charge(c shop.CustomerID, o shop.OrderID, a shop.Money) (shop.Receipt, error) {
    return shop.Receipt{Customer: c, Order: o, Amount: a}, nil
}

func (f *paymentsFake) Refund(o shop.OrderID, a shop.Money) (shop.Receipt, error) {
    if f.refundErr != nil {
        return shop.Receipt{}, f.refundErr
    }
    f.refunds = append(f.refunds, a)
    return shop.Receipt{Order: o, Amount: a}, nil
}

// Cancel must refund the full amount, because the customer paid it at Place.
func TestCancelRefundsFullAmount(t *testing.T) {
    book = newBook()
    f := &paymentsFake{}
    keel.Bind(t, &Payments, f)
    s := NewService()
    o, err := s.Place("c1", 2500)
    if err != nil {
        t.Fatal(err)
    }
    if _, err := s.Cancel(o.ID); err != nil {
        t.Fatal(err)
    }
    if len(f.refunds) != 1 || f.refunds[0] != 2500 {
        t.Fatalf("refunds = %v, want [2500]", f.refunds)
    }
    if _, err := s.Cancel(o.ID); !errors.Is(err, shop.ErrCancelled) {
        t.Fatalf("second cancel: got %v, want ErrCancelled", err)
    }
    if len(f.refunds) != 1 {
        t.Fatalf("second cancel refunded again: %v", f.refunds)
    }
}

// A failed refund must leave the order placed, so the customer is not left unpaid.
func TestCancelKeepsOrderWhenRefundFails(t *testing.T) {
    book = newBook()
    keel.Bind(t, &Payments, &paymentsFake{refundErr: errors.New("down")})
    s := NewService()
    o, err := s.Place("c1", 100)
    if err != nil {
        t.Fatal(err)
    }
    if _, err := s.Cancel(o.ID); err == nil {
        t.Fatal("cancel succeeded with a failed refund")
    }
    got, err := s.Get(o.ID)
    if err != nil {
        t.Fatal(err)
    }
    if got.Status != shop.Placed {
        t.Fatalf("status = %s, want placed", got.Status)
    }
}

// direct delivers at least once, so a repeated message must not fail or change the order.
func TestShippedTwiceIsIdempotent(t *testing.T) {
    book = newBook()
    keel.Bind(t, &Payments, &paymentsFake{})
    s := NewService()
    o, err := s.Place("c1", 100)
    if err != nil {
        t.Fatal(err)
    }
    m := shop.OrderShipped{Order: o.ID, Note: "left at door"}
    for i := 0; i < 2; i++ {
        if err := markShipped(m); err != nil {
            t.Fatalf("delivery %d: %v", i+1, err)
        }
    }
    got, err := s.Get(o.ID)
    if err != nil {
        t.Fatal(err)
    }
    if got.Status != shop.Shipped || got.ShippingNote != "left at door" {
        t.Fatalf("got %+v", got)
    }
    if _, err := s.Cancel(o.ID); !errors.Is(err, shop.ErrShipped) {
        t.Fatalf("cancel shipped: got %v, want ErrShipped", err)
    }
}
