 var skuPattern = regexp.MustCompile(`^[A-Za-z0-9-]{1,32}$`)
 
+// validName reports whether a product name is 1 to 100 characters.
+func validName(name string) bool {
+	return name != "" && utf8.RuneCountInString(name) <= 100
+}
