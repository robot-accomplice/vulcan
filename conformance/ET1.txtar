-- system.vulcan --
// Shop is the online store.
system Shop {
    person Customer "Buys goods"
    external Database "The file"

    container Api {
        Web, Orders, Billing, Store

        Web.Orders:      Orders.NewService
        Orders.Checkout: Billing.NewPayer
        Billing.Ledger:  Store.Open
    }
}
