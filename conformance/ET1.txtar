H4: a type error in a test, with each form on: the error, and no panic
-- want.txt --
error api/orders/x_test.vulcan:7:20 K0008
-- api/billing/billing.vulcan --
package billing

import "shop/lib/money"

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, Ledger.Save("x")
}
-- api/billing/component.vulcan --
component Billing {
    needs port Ledger {
        func Save(id string) error
    }
}
-- api/orders/component.vulcan --
import "shop/lib/money"

component Orders {
    // Checkout takes payment.
    needs port Checkout {
        // Pay takes a payment.
        func Pay(amt money.Money) (money.Receipt, error)
    }
}
