A Go feature newer than Go 1.22 in a body (a range-over-func iterator): accepted, with Go's output.
-- want.txt --
run exit=0 stdout=out.txt
-- api/billing/billing.vulcan --
package billing

import "shop/lib/money"

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, nil
}
-- api/billing/component.vulcan --
component Billing {
}
-- api/orders/component.vulcan --
import "shop/lib/money"

component Orders {
    needs port Checkout {
        func Pay(amt money.Money) (money.Receipt, error)
    }
}
-- api/orders/orders.vulcan --
package orders

import "shop/lib/money"

// Service places orders.
type Service struct{}

// NewService returns a Service.
func NewService() *Service { return &Service{} }

// Place takes payment for an order.
func (s *Service) Place(amt money.Money) (money.Receipt, error) {
	return Checkout.Pay(amt)
}
-- api/web/component.vulcan --
import "shop/lib/money"

component Web {
    entry for Customer

    needs port Orders {
        func Place(amt money.Money) (money.Receipt, error)
    }
}
-- api/web/web.vulcan --
package web

import (
	"context"
	"fmt"
)

func count(n int) func(func(int) bool) {
	return func(yield func(int) bool) {
		for i := 0; i < n; i++ {
			if !yield(i) {
				return
			}
		}
	}
}

func startup(ctx context.Context) error {
	r, err := Orders.Place(42)
	if err != nil {
		return err
	}
	for i := range count(2) {
		fmt.Println("paid", r.Amount, i)
	}
	return nil
}
-- lib/money/library.vulcan --
// money holds amounts.
library money {
}
-- lib/money/money.vulcan --
package money

// Money is an amount in cents.
type Money int64

// Receipt records a payment.
type Receipt struct {
	Amount Money
}
-- out.txt --
paid 42 0
paid 42 1
-- system.vulcan --
// Shop is the online store.
system Shop {
    person Customer "Buys goods"

    container Api {
        Web, Orders, Billing

        Web.Orders:      Orders.NewService
        Orders.Checkout: Billing.NewPayer
    }
}
