A mutex-guarded invariant under concurrent calls: the check runs before the deferred unlock, so it never sees a half-done change (audit P2, B1).
-- want.txt --
run exit=0 stdout=out.txt
-- api/billing/billing.vulcan --
package billing

import (
	"sync"

	"shop/lib/money"
)

// Ledger counts charges and refunds under a lock.
type Ledger struct {
	mu       sync.Mutex
	Charged  int
	Refunded int
}
	invariant Charged >= Refunded

// ChargeAndRefund changes both counts under the lock.
func (l *Ledger) ChargeAndRefund(x int) {
	l.mu.Lock()
	defer l.mu.Unlock()
	l.Charged += x
	l.Refunded += x
}

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	l := &Ledger{}
	var wg sync.WaitGroup
	for range 8 {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for range 20000 {
				l.ChargeAndRefund(1)
			}
		}()
	}
	wg.Wait()
	return money.Receipt{Amount: amt}, nil
}
-- api/billing/component.vulcan --
component Billing {
}
-- api/orders/component.vulcan --
import "shop/lib/money"

component Orders {
    needs port Checkout {
        func Pay(amt money.Money) (money.Receipt, error)
    }
}
-- api/orders/orders.vulcan --
package orders

import "shop/lib/money"

// Service places orders.
type Service struct{}

// NewService returns a Service.
func NewService() *Service { return &Service{} }

// Place takes payment for an order.
func (s *Service) Place(amt money.Money) (money.Receipt, error) {
	return Checkout.Pay(amt)
}
-- api/web/component.vulcan --
import "shop/lib/money"

component Web {
    entry for Customer

    needs port Orders {
        func Place(amt money.Money) (money.Receipt, error)
    }
}
-- api/web/web.vulcan --
package web

import (
	"context"
	"fmt"
)

func startup(ctx context.Context) error {
	r, err := Orders.Place(42)
	if err != nil {
		return err
	}
	fmt.Println("paid", r.Amount)
	return nil
}
-- lib/money/library.vulcan --
// money holds amounts.
library money {
}
-- lib/money/money.vulcan --
package money

// Money is an amount in cents.
type Money int64

// Receipt records a payment.
type Receipt struct {
	Amount Money
}
-- out.txt --
paid 42
-- system.vulcan --
// Shop is the online store.
system Shop {
    person Customer "Buys goods"

    container Api {
        Web, Orders, Billing

        Web.Orders:      Orders.NewService
        Orders.Checkout: Billing.NewPayer
    }
}
