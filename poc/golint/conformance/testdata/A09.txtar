-- api/orders/orders.go --
// Package orders places orders.
package orders

import "shop/lib/money"

// Order is an order.
type Order struct{ ID int }

// Service places orders.
type Service struct {
	checkout Checkout
}

// NewService returns a Service.
func NewService(checkout Checkout) *Service { return &Service{checkout: checkout} }

// Place takes payment for an order.
func (s *Service) Place(amt money.Money) (money.Receipt, error) {
	return s.checkout.Pay(Order{}, amt)
}
-- api/orders/ports.go --
package orders

import "shop/lib/money"

// Checkout takes payment for an order.
type Checkout interface {
	Pay(o Order, amt money.Money) (money.Receipt, error)
}
-- cmd/shop/main.go --
// Command shop runs the shop.
package main

import (
	"context"
	"os"

	"shop/api/web"
	"shop/lib/money"
)

type place struct{}

func (place) Place(amt money.Money) (money.Receipt, error) { return money.Receipt{Amount: amt}, nil }

func main() {
	api := web.New(place{})
	if err := api.Start(context.Background()); err != nil {
		os.Exit(1)
	}
}
