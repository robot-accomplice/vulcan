// Package web is the entry of the customer.
package web

import (
	"context"
	"fmt"
	"net/http"
)

func ping() { _, _ = http.Get("http://127.0.0.1:1") }

var _ = ping

// API is the entry of the customer.
type API struct {
	orders Orders
}

// New returns the API.
func New(orders Orders) *API { return &API{orders: orders} }

// Start places one order.
func (a *API) Start(ctx context.Context) error {
	r, err := a.orders.Place(42)
	if err != nil {
		return err
	}
	fmt.Println("paid", r.Amount)
	return nil
}
