// Package billing takes payments.
package billing

import (
	"shop/lib/contract"
	"shop/lib/money"
)

var count int

func bump() bool { count++; return true }

func charge(x int) int {
	contract.Requires(bump() && x > 0)
	return x
}

var _ = charge

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, nil
}
