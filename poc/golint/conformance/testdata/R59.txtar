-- arch/arch.go --
package arch

// The persons and the external systems.
const (
	Customer Person   = "Customer" // buys goods
	Database External = "Database" // the file
)

// Manifest is the architecture of the shop.
var Manifest = System{
	Parts: []Part{
		Main("cmd/shop"),
		Entry("api/web", Customer),
		Leaf("api/orders"),
		Leaf("api/billing"),
		Gateway("api/store", Database),
		Library("lib/money"),
		Library("lib/contract"),
	},
}
-- cmd/shop/main.go --
// Command shop runs the shop.
package main

import (
	"context"
	"os"

	"shop/api/billing"
	"shop/api/orders"
	"shop/api/store"
	"shop/api/web"
)

func main() {
	keeper := store.Open()
	payer := billing.NewPayer(keeper)
	service := orders.NewService(payer)
	api := web.New(service)
	if err := api.Start(context.Background()); err != nil {
		os.Exit(1)
	}
}
-- lib/money/money.go --
package money

// Money is an amount in cents.
type Money int64

// Receipt records a payment.
type Receipt struct {
	Amount Money
}

// The states of an order.
const (
	Pending   = "pending"
	Paid      = "paid"
	Shipped   = "shipped"
	Cancelled = "cancelled"
)

// Order is an order.
type Order struct {
	ID     string
	Status string
}
