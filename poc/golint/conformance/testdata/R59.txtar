package billing

// Ledger keeps payments.
type Ledger interface {
	Save(id string) error
}
-- api/orders/extra.go --
package orders

import (
	"shop/lib/money"
)

func stopIt(o *money.Order) {
	if o.Status == money.Pending || o.Status == money.Paid {
		o.Status = money.Shipped
	}
}
