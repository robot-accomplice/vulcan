-- api/billing/billing.go --
// Package billing takes payments.
package billing

import (
	"shop/lib/contract"
	"shop/lib/money"
)

// Counter counts down.
type Counter struct{ N int }

// Dec counts down.
func (c *Counter) Dec() { c.N-- }

// Account holds money.
type Account struct {
	Balance int
	C       Counter
}

// Invariant holds after every change.
func (a Account) Invariant() bool { return a.Balance >= 0 && a.C.N >= 0 }

// Drainer returns a function that breaks the account.
func (a *Account) Drainer() func() {
	defer contract.Keep(a)
	return func() { a.Balance = -100 }
}

// Holder embeds an account.
type Holder struct{ Account }

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, nil
}
