A type assertion in a contract (K0512).
-- want.txt --
error api/billing/billing.go:10:20 VL0512
-- api/billing/billing.go --
// Package billing takes payments.
package billing

import (
	"shop/lib/contract"
	"shop/lib/money"
)

func name(v any) string {
	contract.Requires(v.(string) != "")
	return ""
}

var _ = name

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, nil
}
