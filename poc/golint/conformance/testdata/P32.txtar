// Package billing takes payments.
package billing

import "shop/lib/money"

// Settings configure a Payer.
type Settings struct {
	Fee int64
}

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer(s Settings) *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, nil
}
-- cmd/shop/main.go --
// Command shop runs the shop.
package main

import (
	"context"
	"os"

	"shop/api/billing"
	"shop/api/orders"
	"shop/api/web"
)

func main() {
	payer := billing.NewPayer(billing.Settings{Fee: func() int64 { return 1 }()})
	service := orders.NewService(payer)
	api := web.New(service)
	if err := api.Start(context.Background()); err != nil {
		os.Exit(1)
	}
}
