// Command shop runs the shop.
package main

import (
	"context"
	"os"

	"shop/api/billing"
	"shop/api/orders"
	"shop/api/web"
)

func main() {
	payer := billing.NewPayer()
	service := orders.NewService(payer)
	_ = billing.NewPayer()
	api := web.New(service)
	if err := api.Start(context.Background()); err != nil {
		os.Exit(1)
	}
}
