package arch

// The persons and the external systems.
const (
	Customer Person   = "Customer" // buys goods
	Stripe   External = "Stripe"   // cards
)

// Manifest is the architecture of the shop.
var Manifest = System{
	Parts: []Part{
		Main("cmd/shop"),
		Entry("api/web", Customer),
		Gateway("api/billing", Stripe),
		Gateway("api/orders", Stripe),
		Library("lib/money"),
		Library("lib/contract"),
	},
}
