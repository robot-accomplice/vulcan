-- api/billing/billing.go --
// Package billing takes payments.
package billing

import (
	"io"
	"strings"

	"shop/lib/money"
)

// Payer takes payments.
type Payer struct{}

// NewPayer returns a Payer.
func NewPayer() *Payer { return &Payer{} }

// Pay takes a payment.
func (p *Payer) Pay(amt money.Money) (money.Receipt, error) {
	return money.Receipt{Amount: amt}, nil
}

// Statement returns the statement.
func (p *Payer) Statement() (io.ReadCloser, error) { return io.NopCloser(strings.NewReader("")), nil }
-- api/orders/ports.go --
package orders

import (
	"io"

	"shop/lib/money"
)

// Checkout takes payment for an order.
type Checkout interface {
	Pay(amt money.Money) (money.Receipt, error)
	Statement() (io.ReadCloser, error)
}
