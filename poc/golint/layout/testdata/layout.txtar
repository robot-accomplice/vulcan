A1: parts without a package, of the wrong kind, or inside a leaf; packages that the manifest does
not list; package names; an external test package; a file that the build ignores; a manifest
setting that names no leaf.
-- arch/arch.go --
package arch

// The persons and the external systems.
const (
	Customer Person = "Customer" // buys goods
)

// Manifest is the architecture of the shop.
var Manifest = System{
	StrictExempt: []string{"lib/money"}, // want "VL0902"
	Parts: []Part{
		Main("cmd/shop"),
		Entry("api/web", Customer),
		Leaf("api/orders"),
		Leaf("api/billing"),
		Library("lib/money"),
		Library("lib/contract"),
		Leaf("api/missing"),       // want "VL0003"
		Main("api/notmain"),       // want "VL0003"
		Leaf("lib/oops"),          // want "VL0003"
		Leaf("api/orders/inner"),  // want "VL0002"
		Leaf("cmd/tool"),          // want "VL0003"
	},
}
-- api/notmain/notmain.go --
// Package notmain is not package main.
package notmain // want "VL0004"
-- lib/oops/oops.go --
// Package oops is a leaf in lib/.
package oops
-- cmd/tool/main.go --
package main // want "VL0004"

func main() {}
